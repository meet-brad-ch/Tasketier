<Window x:Class="Tasketier.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasketier settings"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture hotkey" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CaptureBox" IsReadOnly="True" Margin="0,0,0,8" PreviewKeyDown="OnHotkeyKeyDown" ToolTip="Click, then press the keys" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="List hotkey" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ListBox" IsReadOnly="True" Margin="0,0,0,8" PreviewKeyDown="OnHotkeyKeyDown" ToolTip="Click, then press the keys" />

        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="Click a hotkey box and press the keys: at least one of Ctrl, Alt, Shift or Win plus a key." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Data folder" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="FolderBox" Margin="0,0,8,8" />
        <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Click="OnBrowse" Margin="0,0,0,8" Padding="12,4" />

        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FolderHint" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

        <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AutostartBox" Content="Start Tasketier with Windows (tray icon and hotkeys)" Margin="0,0,0,16" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="Error" Foreground="#D13B3B" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="300" />
            <Button Content="Save" IsDefault="True" Click="OnSave" Padding="18,4" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" Padding="18,4" />
        </StackPanel>
    </Grid>
</Window>
