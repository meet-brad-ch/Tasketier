<Window x:Class="Tasketier.App.ListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Tasketier.App"
        Title="Tasketier"
        Width="820"
        Height="560"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="OverdueText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="#D13B3B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DoneTitle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TaskRowTemplate" DataType="{x:Type app:TaskRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=OneWay}" Click="OnDoneClick" VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="Done" />
                <ToggleButton Grid.Column="1" IsChecked="{Binding IsPlanned, Mode=OneWay}" Click="OnPlanClick" Width="32" Padding="0" Margin="0,0,8,0" ToolTip="Plan for today" FontSize="14">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Content" Value="☆" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                    <Setter Property="Content" Value="★" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DoneTitle}" FontSize="14" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="OnTitleMouseDown" />
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}"
                             FontSize="14" PreviewKeyDown="OnEditKeyDown" LostFocus="OnEditLostFocus" Loaded="OnEditLoaded" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding TagsText}" Opacity="0.6" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="4" Text="{Binding PriorityText}" Foreground="#D13B3B" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="18" />
                <TextBlock Grid.Column="5" Text="{Binding DueText}" Style="{StaticResource OverdueText}" VerticalAlignment="Center" Margin="12,0,4,0" MinWidth="110" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="?" Width="36" Margin="8,0,0,0" Click="OnHelpClick" ToolTip="The marks you can type and the keys (F1)" />
            <Grid>
                <TextBox x:Name="AddBox" FontSize="15" Padding="8,6" PreviewKeyDown="OnAddKeyDown" TextChanged="OnAddTextChanged" />
                <TextBlock x:Name="AddHint" Text="Add a task… (Enter saves; @today @tomorrow @mon…@sun @15:30 ! !! #tag; ? for all marks)" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.45" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Views" Grid.Column="0" Margin="0,0,10,0" SelectionChanged="OnViewChanged" FontSize="14">
                <ListBoxItem Content="Today" Tag="Today" Padding="10,8" />
                <ListBoxItem Content="Upcoming" Tag="Upcoming" Padding="10,8" />
                <ListBoxItem Content="Inbox" Tag="Inbox" Padding="10,8" />
                <ListBoxItem Content="All" Tag="All" Padding="10,8" />
                <ListBoxItem Content="Done" Tag="Done" Padding="10,8" />
            </ListBox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="FilterBox" Padding="8,5" TextChanged="OnFilterChanged" PreviewKeyDown="OnFilterKeyDown" />
                    <TextBlock x:Name="FilterHint" Text="Filter by title or #tag (Ctrl+F)" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.45" IsHitTestVisible="False" />
                </Grid>
                <ListView x:Name="Tasks" Grid.Row="1" ItemTemplate="{StaticResource TaskRowTemplate}" HorizontalContentAlignment="Stretch" PreviewKeyDown="OnTasksKeyDown" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="Status" DockPanel.Dock="Left" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock DockPanel.Dock="Right" Opacity="0.45" VerticalAlignment="Center" HorizontalAlignment="Right" Text="F2 or double-click edits · Del deletes · Ctrl+Z undoes · Esc hides · F1 help" />
        </DockPanel>
    </Grid>
</Window>
