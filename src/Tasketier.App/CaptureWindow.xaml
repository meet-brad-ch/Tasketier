<Window x:Class="Tasketier.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a task"
        Width="620"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>
    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,14,16,12">
        <StackPanel>
            <DockPanel>
                <ToggleButton x:Name="HelpToggle" DockPanel.Dock="Right" Content="?" Width="36" Margin="8,0,0,0" ToolTip="The marks you can type (F1)" Focusable="False" />
                <TextBox x:Name="Input" FontSize="18" Padding="10,8" TextChanged="OnTextChanged" PreviewKeyDown="OnPreviewKeyDown" />
            </DockPanel>
            <TextBlock x:Name="Preview" Margin="4,8,4,0" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="4,6,4,0" FontSize="11" Opacity="0.5" Text="Enter saves · Esc cancels · @today @tomorrow @mon…@sun @2026-11-03 @+3d due day · @15:30 time · @alarm @alarmN · ! !! priority · #tag · @none · ? or F1" />
            <TextBlock x:Name="HelpText" Margin="4,10,4,0" FontFamily="Consolas" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                       Visibility="{Binding IsChecked, ElementName=HelpToggle, Converter={StaticResource VisibleWhenTrue}}" />
        </StackPanel>
    </Border>
</Window>
