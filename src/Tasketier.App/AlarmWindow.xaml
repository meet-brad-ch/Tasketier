<Window x:Class="Tasketier.App.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasketier alarm"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="Led" Color="#FF6A00" />
        <SolidColorBrush x:Key="LedGhost" Color="#2E1A0C" />
        <SolidColorBrush x:Key="Ink" Color="#1C1C1C" />
        <LinearGradientBrush x:Key="Shell" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFA23B" Offset="0" />
            <GradientStop Color="#FF8C00" Offset="0.5" />
            <GradientStop Color="#D96F00" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B0B0B" Offset="0" />
            <GradientStop Color="#1A1612" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ClockButton" TargetType="Button">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#111111" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1.5" Opacity="0.5" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#111111" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DisarmButton" TargetType="Button" BasedOn="{StaticResource ClockButton}">
            <Setter Property="Background" Value="#B3261E" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>
    <Grid x:Name="Clock" Margin="10,6,10,10" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Shake" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <!-- The clock rattles while it rings. -->
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="Shake" Storyboard.TargetProperty="X" From="-3" To="3" Duration="0:0:0.07" AutoReverse="True" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The snooze bar on top of the body: the big button every bedside clock has. -->
        <Button Grid.Row="0" Click="OnSnoozeBar" Width="220" Height="26" Margin="0,0,0,-6" Panel.ZIndex="1" Cursor="Hand" ToolTip="Snooze one minute (Esc)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bar" Background="#C86200" BorderBrush="#9A4B00" BorderThickness="1" CornerRadius="8,8,0,0">
                        <TextBlock Text="SNOOZE" Foreground="#FFE2C2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#E07200" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- The body. -->
        <Border Grid.Row="1" Background="{StaticResource Shell}" CornerRadius="22" BorderBrush="#B85A00" BorderThickness="2" Padding="18,16,18,14">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.55" /></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The display: a dark inset glass with the LED digits and the task line. -->
                <Border Grid.Row="0" Background="{StaticResource Glass}" CornerRadius="10" BorderBrush="#5A2E00" BorderThickness="2" Padding="16,10,16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The alarm indicator, lit. -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="⏰" Foreground="{StaticResource Led}" FontSize="30" HorizontalAlignment="Center">
                                    <TextBlock.Effect><DropShadowEffect Color="#FF6A00" BlurRadius="12" ShadowDepth="0" Opacity="0.9" /></TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="ALARM" Foreground="{StaticResource Led}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="DueLine" Foreground="#B04A00" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                            <!-- Four seven-segment digits and a blinking colon, filled from code. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Effect><DropShadowEffect Color="#FF6A00" BlurRadius="16" ShadowDepth="0" Opacity="0.85" /></StackPanel.Effect>
                                <Canvas x:Name="HourTens" Width="42" Height="84" Margin="0,0,10,0" />
                                <Canvas x:Name="HourOnes" Width="42" Height="84" Margin="0,0,10,0" />
                                <StackPanel x:Name="Colon" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.1" Duration="0:0:0.5" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </StackPanel.Triggers>
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource Led}" Margin="0,0,0,20" />
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource Led}" />
                                </StackPanel>
                                <Canvas x:Name="MinuteTens" Width="42" Height="84" Margin="0,0,10,0" />
                                <Canvas x:Name="MinuteOnes" Width="42" Height="84" />
                            </StackPanel>
                        </Grid>
                        <!-- The task as the clock's text line. -->
                        <TextBlock Grid.Row="1" x:Name="TitleText" Foreground="{StaticResource Led}" FontFamily="Consolas" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,12,0,2">
                            <TextBlock.Effect><DropShadowEffect Color="#FF6A00" BlurRadius="8" ShadowDepth="0" Opacity="0.7" /></TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>
                <!-- The clock's buttons. -->
                <DockPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="Esc = 1 min" Foreground="#7A3E00" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Done" Click="OnDone" Style="{StaticResource ClockButton}" ToolTip="Complete the task" />
                        <Button Content="5 min" Click="OnSnooze5" Style="{StaticResource ClockButton}" ToolTip="Snooze 5 minutes" />
                        <Button Content="15 min" Click="OnSnooze15" Style="{StaticResource ClockButton}" ToolTip="Snooze 15 minutes" />
                        <Button Content="1 h" Click="OnSnooze60" Style="{StaticResource ClockButton}" ToolTip="Snooze one hour" />
                        <Button Content="Disarm" Click="OnDisarm" Style="{StaticResource DisarmButton}" ToolTip="Acknowledge: the alarm does not come back" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
