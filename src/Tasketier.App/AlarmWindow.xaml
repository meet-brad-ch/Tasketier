<Window x:Class="Tasketier.App.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasketier alarm"
        Width="380"
        Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,12,16,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Left" Text="⏰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Esc snoozes 1 min" Opacity="0.5" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="DueLine" DockPanel.Dock="Right" Opacity="0.7" VerticalAlignment="Center" />
                <TextBlock Text="Alarm" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="TitleText" FontSize="15" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,8" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Done" Click="OnDone" Padding="12,4" Margin="0,0,8,0" ToolTip="Complete the task" />
                <Button Content="5 min" Click="OnSnooze5" Padding="10,4" Margin="0,0,4,0" ToolTip="Snooze 5 minutes" />
                <Button Content="15 min" Click="OnSnooze15" Padding="10,4" Margin="0,0,4,0" ToolTip="Snooze 15 minutes" />
                <Button Content="1 h" Click="OnSnooze60" Padding="10,4" Margin="0,0,8,0" ToolTip="Snooze one hour" />
                <Button Content="Disarm" Click="OnDisarm" Padding="12,4" ToolTip="Acknowledge: the alarm does not come back" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
