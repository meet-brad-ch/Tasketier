<Window x:Class="Tasketier.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasketier help"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Writing a task" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="SyntaxText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" />
        <TextBlock Text="Keys in the list" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="ShortcutsText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" />
        <TextBlock x:Name="HotkeysText" FontSize="13" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Padding="18,4" />
    </StackPanel>
</Window>
